# Python bytecode from scripts/ and any tooling run locally. Running
# `python -m py_compile scripts/verify_references.py` as a smoke test writes
# scripts/__pycache__/. CI now also produces it: the chrome gate and its
# self-test both import from scripts/ on every pipeline run. Ignored here so a
# local smoke test and a pipeline run leave the tree equally clean.
__pycache__/
*.py[cod]

# Jekyll build output and local caches.
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/


# Generated locally by `jekyll build` / `bundle`. Not committed:
# GitHub Pages resolves its own pinned gem set and only reads the Gemfile to
# decide whether to run Bundler, so a committed lock file buys nothing and can
# fail the Pages build with "Your Gemfile.lock is not compatible".
Gemfile.lock
